{
	"name": "react-example",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"check:env": "node scripts/check-env.mjs",
		"predev": "yarn check:env",
		"prebuild": "yarn check:env",
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start --port 3000",
		"clean": "rm -rf .next dist",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "yarn format:check && yarn lint && yarn typecheck && yarn build",
		"prepare": "husky"
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"lucide-react": "^0.546.0",
		"motion": "^12.23.24",
		"next": "^15.5.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@tailwindcss/postcss": "^4.1.14",
		"@types/node": "^22.14.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"eslint": "^9.39.0",
		"eslint-config-next": "^15.5.0",
		"eslint-config-prettier": "^10.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.0",
		"tailwindcss": "^4.1.14",
		"typescript": "~5.8.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,yml,yaml}": [
			"prettier --write"
		]
	}
}
